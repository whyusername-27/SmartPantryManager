<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings &amp; Preferences"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/dark_navy"
        android:layout_marginBottom="24dp" />

    <!-- Toggle 1: Expiring-Soon Alerts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expiring-Soon Alerts"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/dark_navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notify when items are near expiration"
                android:textSize="12sp"
                android:textColor="#757575" />
        </LinearLayout>

        <Switch
            android:id="@+id/switchExpiryAlerts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Toggle 2: Preferred Measurement Units -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Metric Units"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/dark_navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Display weights in kg/g instead of lbs/oz"
                android:textSize="12sp"
                android:textColor="#757575" />
        </LinearLayout>

        <Switch
            android:id="@+id/switchMetricUnits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Clear Database Action -->
    <Button
        android:id="@+id/btnClearPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear All Pantry Items"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textColor="@color/white"
        android:padding="12dp" />

</LinearLayout>